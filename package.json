{
  "name": "earthonline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A street-level city exploration game with local activities and optional shared presence.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "server": "node server/index.mjs",
    "game": "node scripts/minigame.mjs",
    "building": "node tooling/check-building.mjs",
    "creator-kit": "node scripts/build-minigame-kit.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1",
    "ws": "8.22.0",
    "sharp": "0.34.5",
    "express": "5.3.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
